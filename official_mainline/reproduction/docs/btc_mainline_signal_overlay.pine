//@version=6
indicator("BTC Mainline Signal Overlay (VP-Gated Mainline)", overlay=true, max_labels_count=500, max_lines_count=500)

// -----------------------------------------------------------------------------
// Current adopted mainline, chart-state approximation for 4h BTC charts:
// - Core = 1.00
// - S1 = 1.00 with ATRVT_90D_med_035_150
// - S2 = 1.00 with ATRVT_60D_med_035_150
// - Core sell-side = EMA250 bearish deterioration with 2-bar confirm
// - Stable re-entry = close3
// - High-churn re-entry = strict EMA50 + breakout_4
// - HV percentile >= 85 forces the high-churn gate earlier
// - Weekly RSI(14) <= 30 override_hold
// - S1 gate = volume-profile proxy (LB60 / escape 0.50 ATR / vol ratio20 1.20)
//
// This is a 4h visualization overlay. It approximates the current adopted
// state logic for chart review. It does not reproduce the 5m execution engine.
// -----------------------------------------------------------------------------

showStatusTable = input.bool(true, "Show status table")
showCoreBg = input.bool(true, "Shade core flat region")
showSleeve1 = input.bool(true, "Show Sleeve #1 markers")
showSleeve2 = input.bool(true, "Show Sleeve #2 markers")
showBlockedS1 = input.bool(true, "Show S1 blocked markers")

clampf(x, lo, hi) =>
    math.max(lo, math.min(hi, x))

// ===== Shared base =====
ema250 = ta.ema(close, 250)
ema200 = ta.ema(close, 200)
ema50 = ta.ema(close, 50)
ema20 = ta.ema(close, 20)
atr14 = ta.atr(14)
[_, _, adx14] = ta.dmi(14, 14)

emaSlope250 = ema250 - ema250[20]
emaSlope200 = ema200 - ema200[20]
ema50Slope = ema50 - ema50[1]

barRange = high - low
closeLocation = barRange > 0 ? (close - low) / barRange : 0.5
barRangeAtr = atr14 > 0 ? barRange / atr14 : 0.0
volMa20 = ta.sma(volume, 20)

bbBasis = ta.sma(close, 20)
bbDev = ta.stdev(close, 20)
bbUpper = bbBasis + 2.0 * bbDev
bbLower = bbBasis - 2.0 * bbDev
bbWidth = bbBasis != 0 ? (bbUpper - bbLower) / bbBasis : 0.0
bbWidthMa = ta.sma(bbWidth, 200)
bbWidthNorm = (na(bbWidthMa) or bbWidthMa == 0) ? 0.0 : bbWidth / bbWidthMa

weeklyRsi14Completed = request.security(
     syminfo.tickerid,
     "W",
     ta.rsi(close, 14)[1],
     barmerge.gaps_off,
     barmerge.lookahead_off
)

// ===== Background HV / ATRVT =====
atrPct = close != 0 ? atr14 / close : 0.0
hvLogRet = math.log(close / nz(close[1], close))
hv14Raw = ta.stdev(hvLogRet, 14 * 6)
hv14Ann = na(hv14Raw) ? na : hv14Raw * math.sqrt(6.0 * 365.0)
hvPct180 = na(hv14Ann) ? 0.0 : ta.percentrank(hv14Ann, 180 * 6) / 100.0
hvForceHighChurn = hvPct180 >= 0.85

atrRefS1 = ta.percentile_linear_interpolation(atrPct, 90 * 6, 50)
atrRefS2 = ta.percentile_linear_interpolation(atrPct, 60 * 6, 50)
atrScaleS1 = (na(atrRefS1) or atrPct <= 0) ? 1.0 : clampf(atrRefS1 / atrPct, 0.35, 1.50)
atrScaleS2 = (na(atrRefS2) or atrPct <= 0) ? 1.0 : clampf(atrRefS2 / atrPct, 0.35, 1.50)

// ===== Baseline core path for churn detection =====
baseBearish = close < ema250 and emaSlope250 < 0
baseCloseConfirm = close > ema250
baseWeeklyOverride = weeklyRsi14Completed <= 30

var int baseState = 2
var int baseBearCount = 0
var int baseCloseCount = 0

baseBearCount := baseBearish ? baseBearCount + 1 : 0
baseCloseCount := baseCloseConfirm ? baseCloseCount + 1 : 0

if barstate.isconfirmed
    if baseState == 2
        if baseBearCount >= 2
            baseState := 0
        else if baseBearCount == 1
            baseState := 1
    else if baseState == 1
        if baseBearCount >= 2
            baseState := 0
        else if baseBearCount == 0
            baseState := 2
    else if baseState == 0
        if baseCloseCount >= 3
            baseState := 2
        else if baseWeeklyOverride
            baseState := 3
            baseBearCount := 0
            baseCloseCount := 0
    else if baseState == 3
        if baseCloseCount >= 3
            baseState := 2

baseTargetUnit = baseState == 2 or baseState == 3 ? 1.0 : baseState == 1 ? 0.5 : 0.0
baseFlip = baseTargetUnit != nz(baseTargetUnit[1], baseTargetUnit)
flip30 = ta.sum(baseFlip ? 1.0 : 0.0, 30 * 6)
flip60 = ta.sum(baseFlip ? 1.0 : 0.0, 60 * 6)
flipHighChurn = flip30 >= 2 and flip60 >= 3
isHighChurn = flipHighChurn or hvForceHighChurn
instabilitySource =
     flipHighChurn and hvForceHighChurn ? "both" :
     flipHighChurn ? "flips" :
     hvForceHighChurn ? "hv_force" : "stable"

// ===== Adopted core path =====
strictEma50Ok = ema50 > ema250 and ema50Slope > 0

var int coreState = 2
var int coreBearCount = 0
var int coreCloseCount = 0
var int coreQualBars = 0
var float armedTriggerHigh = na
var string coreGate = "baseline_close3"

coreBearCount := baseBearish ? coreBearCount + 1 : 0
coreCloseCount := baseCloseConfirm ? coreCloseCount + 1 : 0

if barstate.isconfirmed
    coreGate := coreGate
    if coreState == 2
        if coreBearCount >= 2
            coreState := 0
        else if coreBearCount == 1
            coreState := 1
    else if coreState == 1
        if coreBearCount >= 2
            coreState := 0
        else if coreBearCount == 0
            coreState := 2
    else if coreState == 0
        if coreCloseCount >= 3
            if not isHighChurn
                coreState := 2
                coreGate := "baseline_close3"
            else if strictEma50Ok
                coreState := 4
                coreGate := "strict_and_breakout4"
                coreQualBars := 0
                armedTriggerHigh := high
        else if weeklyRsi14Completed <= 30
            coreState := 3
            coreGate := "weekly_rsi30_hold"
            coreBearCount := 0
            coreCloseCount := 0
    else if coreState == 4
        coreGate := "strict_and_breakout4"
        coreQualBars += 1
        if weeklyRsi14Completed <= 30
            coreState := 3
            coreGate := "weekly_rsi30_hold"
            coreQualBars := 0
            armedTriggerHigh := na
            coreBearCount := 0
            coreCloseCount := 0
        else if coreBearCount >= 2 or coreQualBars >= 4
            coreState := 0
            coreQualBars := 0
            armedTriggerHigh := na
            coreBearCount := 0
            coreCloseCount := 0
        else if not na(armedTriggerHigh) and close > armedTriggerHigh
            coreState := 2
            coreGate := "strict_and_breakout4"
            coreQualBars := 0
            armedTriggerHigh := na
            coreBearCount := 0
            coreCloseCount := 0
    else if coreState == 3
        if coreCloseCount >= 3
            coreState := 2
            coreGate := "baseline_close3"
        else
            coreGate := "weekly_rsi30_hold"

coreTargetUnit = coreState == 2 or coreState == 3 ? 1.0 : coreState == 1 ? 0.5 : 0.0
coreExposure = coreTargetUnit * 1.0

coreRe = coreTargetUnit > 0 and nz(coreTargetUnit[1], 0) == 0
coreFlat = coreTargetUnit == 0 and nz(coreTargetUnit[1], 0) > 0

// ===== Sleeve #1 with VP proxy gate =====
s1Weight = 1.0
s1Donchian = ta.highest(high[1], 20)
s1StructureLow = ta.lowest(low[1], 20)

var int s1SqueezeCount = 0
s1SqueezeCount := bbWidthNorm < 0.90 ? s1SqueezeCount + 1 : 0
s1PrevSqueezeReady = s1SqueezeCount[1] >= 6

s1TrendOk = close > ema200 and emaSlope200 > 0 and adx14 >= 10
s1Breakout = close > s1Donchian
s1QualityOk = closeLocation >= 0.60 and barRangeAtr >= 0.55 and (na(volMa20) ? true : volume >= volMa20)
s1Candidate = s1TrendOk and s1Breakout and s1PrevSqueezeReady and s1QualityOk

// Lightweight chart-side VP proxy:
// use the HLC3 of the highest-volume bar inside the last 60 bars as a proxy HVN.
hvnOffset = math.abs(ta.highestbars(volume, 60))
hvnPrice = hlc3[hvnOffset]
s1HvnEscapeAtr = atr14 > 0 and not na(hvnPrice) ? (close - hvnPrice) / atr14 : na
s1VolRatio20 = not na(volMa20) and volMa20 > 0 ? volume / volMa20 : na
s1GatePass = s1Candidate and not na(s1HvnEscapeAtr) and not na(s1VolRatio20) and s1HvnEscapeAtr >= 0.50 and s1VolRatio20 >= 1.20
s1Blocked = s1Candidate and not s1GatePass
s1GateReason =
     not s1Candidate ? "not_applicable" :
     s1GatePass ? "pass" :
     (s1HvnEscapeAtr >= 0.50 ? "fail_volume_ratio" :
      s1VolRatio20 >= 1.20 ? "fail_hvn_escape" : "fail_both")

var bool s1Active = false
var float s1EntryPrice = na
var float s1EntryAtr = na
var float s1Stop = na
var float s1Highest = na

s1Buy = false
s1Sell = false

if barstate.isconfirmed
    s1Buy := false
    s1Sell := false

    if s1Active
        s1Highest := math.max(nz(s1Highest, high), high)
        s1CurStop = nz(s1Stop, close)
        s1ProfitAtr = (s1Highest - nz(s1EntryPrice, close)) / math.max(nz(s1EntryAtr, atr14), 1e-6)

        if s1ProfitAtr >= 2.5
            s1CurStop := math.max(s1CurStop, s1Highest - 5.0 * atr14)

        s1CurStop := math.min(s1CurStop, s1Highest)

        if low <= s1CurStop
            s1Active := false
            s1Sell := true
            s1EntryPrice := na
            s1EntryAtr := na
            s1Stop := na
            s1Highest := na
        else
            s1Stop := s1CurStop

    if not s1Active and s1GatePass
        s1EntryPrice := close
        s1EntryAtr := atr14
        s1Highest := high
        s1Stop := math.min(s1EntryPrice - 3.2 * atr14, nz(s1StructureLow, s1EntryPrice - 3.2 * atr14))
        s1Active := true
        s1Buy := true

s1Exposure = s1Active ? s1Weight * atrScaleS1 : 0.0

// ===== Sleeve #2 =====
s2Weight = 1.0
rangeHigh20 = ta.highest(high[1], 20)
rangeLow20 = ta.lowest(low[1], 20)
rangeMid20 = (rangeHigh20 + rangeLow20) / 2.0
rangeWidth = rangeHigh20 - rangeLow20
rangeWidthAtr = atr14 > 0 ? rangeWidth / atr14 : 0.0
rangePosition = rangeWidth > 0 ? (close - rangeLow20) / rangeWidth : 0.5
lowerRotationZone = rangeLow20 + rangeWidth * 0.35
upperRotationCap = rangeLow20 + rangeWidth * 0.85
reclaimHigh2 = ta.highest(high[1], 2)
rotationPivotLow5 = ta.lowest(low[1], 5)
swingTrailLow8 = ta.lowest(low[1], 8)
emaSlopeAtr = atr14 > 0 ? emaSlope200 / atr14 : 0.0

touchLowerRotation = low <= lowerRotationZone and rangePosition <= 0.45 and close > rangeLow20
recentLowerRotationTouch = ta.highest(touchLowerRotation[1] ? 1.0 : 0.0, 6) > 0
rotationReclaimOk = close > reclaimHigh2 and close > ema20 and close >= rangeMid20 and closeLocation >= 0.55 and close <= upperRotationCap
bullishBackdropOk = close > ema200 and ema50 >= ema200 and emaSlopeAtr > -0.08
rotationContextOk = rangeWidthAtr >= 2.5 and rangeWidthAtr <= 7.5 and adx14 <= 28.0 and bbWidthNorm <= 1.15
s2EntrySignal = recentLowerRotationTouch and rotationReclaimOk and bullishBackdropOk and rotationContextOk

var bool s2Active = false
var float s2EntryPrice = na
var float s2EntryAtr = na
var float s2Stop = na
var float s2Highest = na

s2Buy = false
s2Sell = false

if barstate.isconfirmed
    s2Buy := false
    s2Sell := false

    if s2Active
        s2Highest := math.max(nz(s2Highest, high), high)
        s2CurStop = nz(s2Stop, close)
        s2ProfitAtr = (s2Highest - nz(s2EntryPrice, close)) / math.max(nz(s2EntryAtr, atr14), 1e-6)

        if s2ProfitAtr >= 1.4
            s2CurStop := math.max(s2CurStop, s2Highest - 3.6 * atr14)

        s2CurStop := math.max(s2CurStop, nz(swingTrailLow8, s2CurStop))
        s2CurStop := math.min(s2CurStop, s2Highest)

        if low <= s2CurStop
            s2Active := false
            s2Sell := true
            s2EntryPrice := na
            s2EntryAtr := na
            s2Stop := na
            s2Highest := na
        else
            s2Stop := s2CurStop

    if not s2Active and s2EntrySignal
        s2EntryPrice := close
        s2EntryAtr := atr14
        s2Highest := high
        s2AtrStop = s2EntryPrice - 2.2 * atr14
        s2Stop := math.max(s2AtrStop, nz(rotationPivotLow5, s2AtrStop))
        s2Active := true
        s2Buy := true

s2Exposure = s2Active ? s2Weight * atrScaleS2 : 0.0

// ===== Total =====
totalExposure = coreExposure + s1Exposure + s2Exposure
stateText =
     coreTargetUnit == 1.0 and not s1Active and not s2Active ? "core_full_s1_0_s2_0" :
     coreTargetUnit == 0.5 and not s1Active and not s2Active ? "core_partial_s1_0_s2_0" :
     coreTargetUnit == 0.0 and not s1Active and not s2Active ? "core_flat_s1_0_s2_0" :
     "core_" + (coreTargetUnit == 1.0 ? "full" : coreTargetUnit == 0.5 ? "partial" : "flat") + "_s1_" + (s1Active ? "1" : "0") + "_s2_" + (s2Active ? "1" : "0")

// ===== Visuals =====
plot(ema250, "EMA250", color=color.new(color.blue, 0), linewidth=2)
plot(ema50, "EMA50", color=color.new(color.purple, 0), linewidth=1)
bgcolor(showCoreBg and coreTargetUnit == 0.0 ? color.new(color.gray, 86) : na)

plotshape(coreRe, title="RE", style=shape.triangleup, location=location.belowbar, color=color.black, text="RE", textcolor=color.black, size=size.tiny)
plotshape(coreFlat, title="FLAT", style=shape.xcross, location=location.abovebar, color=color.black, text="FLAT", textcolor=color.black, size=size.tiny)

plotshape(showSleeve1 and s1Buy, title="S1B", style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), text="S1B", textcolor=color.new(color.green, 0), size=size.tiny)
plotshape(showSleeve1 and s1Sell, title="S1S", style=shape.circle, location=location.abovebar, color=color.new(color.green, 0), text="S1S", textcolor=color.new(color.green, 0), size=size.tiny)
plotshape(showBlockedS1 and s1Blocked, title="S1X", style=shape.diamond, location=location.abovebar, color=color.new(color.gray, 0), text="S1X", textcolor=color.new(color.gray, 0), size=size.tiny)
plotshape(showSleeve2 and s2Buy, title="S2B", style=shape.square, location=location.belowbar, color=color.new(color.orange, 0), text="S2B", textcolor=color.new(color.orange, 0), size=size.tiny)
plotshape(showSleeve2 and s2Sell, title="S2S", style=shape.square, location=location.abovebar, color=color.new(color.orange, 0), text="S2S", textcolor=color.new(color.orange, 0), size=size.tiny)

// ===== Status table =====
var table t = table.new(position.top_right, 2, 11, border_width=1)
if showStatusTable and barstate.islast
    table.cell(t, 0, 0, "Mainline", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(t, 1, 0, "4H", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(t, 0, 1, "State")
    table.cell(t, 1, 1, stateText)
    table.cell(t, 0, 2, "Core gate")
    table.cell(t, 1, 2, coreGate)
    table.cell(t, 0, 3, "Instability")
    table.cell(t, 1, 3, isHighChurn ? "highly_unstable" : "stable")
    table.cell(t, 0, 4, "Source")
    table.cell(t, 1, 4, instabilitySource)
    table.cell(t, 0, 5, "HV pct")
    table.cell(t, 1, 5, str.tostring(hvPct180 * 100.0, "#.0"))
    table.cell(t, 0, 6, "ATR S1/S2")
    table.cell(t, 1, 6, str.tostring(atrScaleS1, "#.00") + " / " + str.tostring(atrScaleS2, "#.00"))
    table.cell(t, 0, 7, "S1 gate")
    table.cell(t, 1, 7, s1GatePass ? "pass" : s1GateReason)
    table.cell(t, 0, 8, "S1 VP")
    table.cell(t, 1, 8, str.tostring(s1HvnEscapeAtr, "#.00") + " / " + str.tostring(s1VolRatio20, "#.00"))
    table.cell(t, 0, 9, "Exposure")
    table.cell(t, 1, 9, str.tostring(totalExposure, "#.00"))
    table.cell(t, 0, 10, "Weekly RSI")
    table.cell(t, 1, 10, str.tostring(weeklyRsi14Completed, "#.0"))
